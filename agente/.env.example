# Copie para .env e preencha com uma chave real (nunca commitar .env preenchido)

GOOGLE_API_KEY=
# ou, para revezar entre várias chaves do plano estudante (round-robin):
# GOOGLE_API_KEYS=chave1,chave2,chave3

# Opcionais (têm default no código, só sobrescreva se precisar)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_TEMPERATURE=0.1
# PRESCRIPTION_CONFIDENCE_THRESHOLD=0.9
# TESSERACT_LANG=por
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Fallback entre modelos Gemini antes do Tesseract (agents/specs/gemini-model-fallback.md).
# Sem essa env, só o GEMINI_MODEL é usado. Uma tentativa por modelo, na ordem, trocando só
# em 429/5xx/404/timeout; a cadeia toda cabe em GEMINI_EXTRACTION_BUDGET_MS (25 s).
# GEMINI_MODELS=gemini-flash-latest,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# GEMINI_EXTRACTION_BUDGET_MS=25000
